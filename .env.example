# Copia questo file in .env e inserisci i tuoi valori reali
# Ottieni la API key da https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Mittente: in test puoi usare il default Resend, in produzione il tuo dominio verificato
# Default test (funziona subito senza verificare dominio, manda SOLO alla tua email registrata su Resend):
MAIL_FROM=onboarding@resend.dev

# In produzione (dopo aver verificato youbidata.com su Resend):
# MAIL_FROM=proposte@youbidata.com

# Destinatario fisso: in modalità test deve essere la tua email registrata su Resend
MAIL_TO=tua_email@esempio.com

# Oggetto dell'email inviata al click
MAIL_SUBJECT=Proposta YouBiData — test

PORT=3000

# ─────────────────────────────────────────────
# STRIPE (demo pagamenti — modalità test)
# Ottieni le chiavi da https://dashboard.stripe.com/test/apikeys
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Generato lanciando: stripe listen --forward-to localhost:3000/webhooks/stripe
# (vedi README sezione "Pagamenti — webhook locale")
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# PAYPAL (demo pagamenti — sandbox)
# Crea un'app sandbox su https://developer.paypal.com/dashboard/applications/sandbox
# ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
PAYPAL_ENV=sandbox

# URL base usata per success/cancel Stripe (deve essere raggiungibile dal browser)
PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# QAPLA (demo tracking spedizioni)
# Dashboard: https://www.qapla.it → Impostazioni → API
# ─────────────────────────────────────────────
QAPLA_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# A-CUBE (fatturazione elettronica — sandbox)
# Credenziali sandbox: https://acubeapi.com
# ─────────────────────────────────────────────
ACUBE_EMAIL=tua-email@example.com
ACUBE_PASSWORD=xxxxxxxxxxxxxxxxxxxx
ACUBE_ENV=sandbox
ACUBE_TEST_FISCAL_ID=IT01234567890
